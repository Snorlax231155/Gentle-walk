{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGentleWalkCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": [
        "arn:aws:logs:ap-south-1:651694719691:log-group:/ecs/gentle-walk:*"
      ]
    }
  ]
}
