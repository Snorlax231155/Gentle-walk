{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDynamoDbAirQualityRead",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-south-1:651694719691:table/gentle-walk-air-quality"
    },
    {
      "Sid": "AllowS3OverpassCacheRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::gentle-walk-overpass-cache-651694719691/*"
    }
  ]
}
